generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
  output     = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model SnapTldState {
  id                String   @id
  watchlistJson     String
  reviewedJson      String
  hiddenJson        String
  notesJson         String
  activeWeightsYaml String
  settingsJson      String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model SnapTldFeedOverride {
  feedId       String   @id
  status       String?
  scheduleJson String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SnapTldReport {
  id          String   @id
  title       String
  generatedAt DateTime
  domains     Int
  highlight   String
  format      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SnapTldImportedDomain {
  slug                   String   @id
  domain                 String
  tld                    String
  source                 String
  sourceLabel            String
  importedAt             DateTime
  importedBy             String
  batchId                String
  status                 String
  expiresAt              String
  totalScore             Int
  verdict                String
  estimatedValueMin      Int
  estimatedValueMax      Int
  estimatedValueCurrency String
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([batchId])
  @@index([source])
}

model SnapTldDomainAnalysis {
  slug                    String   @id
  domain                  String
  tld                     String
  source                  String
  fetchedAt               DateTime
  importedAt              DateTime @default(now())
  expiresAt               String
  labelLength             Int      @default(0)
  totalScore              Int
  verdict                 String
  status                  String
  analysisStepCount       Int      @default(0)
  subAnalysisCount        Int      @default(0)
  completedSubAnalysisIds String   @default("")
  hasStructure            Boolean  @default(false)
  hasLexical              Boolean  @default(false)
  hasBrand                Boolean  @default(false)
  hasMarket               Boolean  @default(false)
  hasRisk                 Boolean  @default(false)
  hasSalability           Boolean  @default(false)
  hasSeo                  Boolean  @default(false)
  hasHistory              Boolean  @default(false)
  aiSummary               String
  estimatedValueMin       Int
  estimatedValueMax       Int
  estimatedValueCurrency  String
  categoriesJson          String
  seoJson                 String
  waybackJson             String
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([source])
  @@index([importedAt])
  @@index([status])
  @@index([totalScore])
  @@index([verdict])
  @@index([labelLength])
  @@index([analysisStepCount])
  @@index([subAnalysisCount])
  @@index([hasStructure])
  @@index([hasLexical])
  @@index([hasBrand])
  @@index([hasMarket])
  @@index([hasRisk])
  @@index([hasSalability])
  @@index([hasSeo])
  @@index([hasHistory])
}

model DriveItem {
  id              String          @id
  name            String
  kind            String
  mimeType        String?
  extension       String?
  sizeBytes       Int             @default(0)
  parentId        String?
  parent          DriveItem?      @relation("DriveFolderChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children        DriveItem[]     @relation("DriveFolderChildren")
  pathJson        String
  ownerId         String
  ownerName       String
  ownerInitials   String
  isFavorite      Boolean         @default(false)
  isDeleted       Boolean         @default(false)
  storageKey      String?
  previewType     String
  previewUrl      String?
  previewContent  String?
  previewLanguage String?
  previewAccent   String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  activities      DriveActivity[]

  @@index([parentId])
  @@index([kind])
  @@index([isDeleted])
}

model DriveActivity {
  id        String    @id
  itemId    String
  item      DriveItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  actor     String
  action    String
  createdAt DateTime  @default(now())

  @@index([itemId])
}

model BillingCompany {
  id          String           @id
  name        String
  orgNumber   String?
  vatNumber   String?
  email       String?
  phone       String?
  address     String?
  postalCode  String?
  city        String?
  bank        String?
  iban        String?
  bankgiro    String?
  logoDataUrl String?
  fSkatt      Boolean          @default(false)
  isDefault   Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  invoices    BillingInvoice[]
}

model BillingCustomer {
  id            String           @id
  name          String
  orgNumber     String?
  email         String?
  phone         String?
  address       String?
  postalCode    String?
  city          String?
  contactPerson String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  invoices      BillingInvoice[]
}

model BillingInvoice {
  id                    String               @id
  companyId             String
  company               BillingCompany       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  customerId            String?
  customer              BillingCustomer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName          String
  customerOrgNumber     String?
  customerEmail         String?
  customerPhone         String?
  customerAddress       String?
  customerPostalCode    String?
  customerCity          String?
  customerContactPerson String?
  status                String
  vatRate               Float
  currency              String               @default("SEK")
  dueDate               String
  issuedDate            String
  paidDate              String?
  paymentTermsDays      Int?
  notes                 String?
  theirReference        String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  lines                 BillingInvoiceLine[]

  @@index([companyId])
  @@index([customerId])
  @@index([status])
}

model BillingInvoiceLine {
  id            String         @id
  invoiceId     String
  invoice       BillingInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  position      Int
  description   String
  quantity      Float
  unit          String?
  unitPriceOre  Int
  articleNumber String?

  @@index([invoiceId])
}

model Subscription {
  id                 String                   @id
  name               String
  description        String                   @default("")
  category           String
  status             String
  amountSEK          Int
  billingCycle       String
  startedAt          String
  nextRenewal        String
  cancelledAt        String?
  website            String?
  notes              String?
  owner              String?
  businessExpense    Boolean                  @default(false)
  reminderDaysBefore Int?
  archived           Boolean                  @default(false)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  priceHistory       SubscriptionPricePoint[]

  @@index([status])
  @@index([category])
  @@index([nextRenewal])
  @@index([archived])
}

model SubscriptionPricePoint {
  id             String       @id
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  date           String
  amountSEK      Int
  createdAt      DateTime     @default(now())

  @@unique([subscriptionId, date])
  @@index([subscriptionId])
}
